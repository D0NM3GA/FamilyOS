# Copy to .env and fill in real values. Never commit .env.
# If any value contains a literal $, use single quotes — docker compose expands $
# inside double-quoted .env values when it reads this file for docker-compose.yml.

# Matches docker-compose.yml's postgres service (npm run db:up)
DATABASE_URL="postgresql://familycrm:familycrm@localhost:5432/familycrm_dev?schema=public"

# Phase 41: the browser tests' own database (npm run test:e2e). Every run drops it and makes it
# again, so its name must end in _e2e, and it must not be DATABASE_URL's. Same server and user.
E2E_DATABASE_URL="postgresql://familycrm:familycrm@localhost:5432/familycrm_e2e"

# Overrides docker-compose.yml's Postgres password (docker-compose reads this same
# .env file). Keep this in sync with the password in DATABASE_URL above by hand —
# prisma.config.ts loads .env via plain dotenv, which doesn't expand ${} references.
# Only takes effect on a FRESH volume: `npm run db:up` the first time, or after
# `docker compose down -v` (which deletes all local data). Changing it later, with
# the volume already created, does nothing until you do one of those.
# If you pick a stronger password, percent-encode any @ : / % # before pasting it into
# DATABASE_URL above — those characters are separators in a connection URL.
POSTGRES_PASSWORD="familycrm"

# Generate with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Optional (Phase 40.1b): sign-in with Microsoft and the Microsoft 365 features (Outlook, mail,
# alert email, receipts). From the Entra app registration — see docs/BUILD.md Phase -1. Set all
# three or none; some but not all stops the app at start.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID=""

# Optional (Phase 40.3): sign in with your own OpenID Connect provider (Google, Authentik,
# Keycloak, Pocket ID…). Register a confidential client there with the redirect address
# <BETTER_AUTH_URL>/api/auth/callback/oidc, and set all four (or none; some but not all stops the
# app at start). OIDC_NAME is the button's label ("Sign in with <name>"). The provider must send
# email_verified (ID token or userinfo) for invites to work with it (README "How access works").
OIDC_DISCOVERY_URL=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_NAME=""
# Optional: space-separated, must include openid and email. Default "openid email profile".
OIDC_SCOPES=""

# Optional (Phase 40.1c): the reverse proxy's address or subnet, comma-separated (e.g.
# "10.0.0.2" or "172.16.0.0/12"), so sign-in rate limits key on the real client address.
TRUSTED_PROXIES=""

# Phase 21: the shared mailbox Sticker Store alert emails are sent from (README "Alerts").
# Leave empty and the email channel shows as "not set up yet".
ALERT_MAILBOX=""

# Phase 21.6: phone push. Optional since Phase 45.2: left empty, the server makes its own keys
# and keeps them in the database (encrypted with INTEGRATION_ENCRYPTION_KEY), using
# CONTACT_EMAIL, or the https:// BETTER_AUTH_URL, as the contact push services ask for. Set them
# only to keep keys you already have (`node scripts/generate-vapid.mjs`); changing them later
# means every phone has to turn alerts on again.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""

# Optional — exact name of a specific calendar (as it appears in Outlook's calendar list)
# to show on the dashboard, e.g. a synced Google Calendar. Since Phase 45.2 each Microsoft
# grown-up picks their own in Settings → Calendar on Home; this is only the default for
# anyone who hasn't. Leave unset to use the signed-in user's default calendar instead.
FAMILY_CALENDAR_NAME=""

# Encrypts household-level third-party integration credentials (SimpleFIN, Kroger,
# Smartcar, ...) at rest — see lib/crypto.ts and docs/BUILD.md Phase 4.5. Deliberately
# separate from BETTER_AUTH_SECRET. Must be 32 random bytes, base64-encoded. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=""

# Contact address for outside services that ask for one in the User-Agent header
# (api.weather.gov's Terms of Service, Open Food Facts; see lib/user-agent.ts) — any working
# address for whoever runs this install. Falls back to a generic placeholder if unset, so this
# is optional, but the fallback isn't reachable if they ever need to follow up.
# (NWS_CONTACT_EMAIL, its older name, still works.)
CONTACT_EMAIL=""

# Not read by the app itself — this is a note for whoever deploys it. "Today"/due-date
# calculations throughout this app (lib/tasks/schedule.ts's atMidnight, board queries,
# lib/format.ts) follow the SERVER PROCESS's own local clock, not the household timezone
# set in Settings → Household. Set the deploy's TZ env var to match that setting (e.g.
# TZ=America/New_York) — see lib/household-settings.ts's warnIfTimezoneMismatch and
# docs/BUILD.md Phase 7 for why this hasn't been threaded through as a real per-request
# value yet.

# Sentry error + performance monitoring (Phase 15). Leave empty to turn Sentry off entirely.
# The DSN isn't a secret (it ships to the browser); find it in Sentry → Project Settings →
# Client Keys. What may be sent is fixed in lib/observability/ — see README "Error monitoring".
NEXT_PUBLIC_SENTRY_DSN=""
# Only needed once hosting uploads source maps. Never commit a real value.
# SENTRY_AUTH_TOKEN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""

# `npm run db:seed` (prisma/seed.ts): the first admin. Use the address you sign in to
# Microsoft with, so your first sign-in links to this profile. Kept out of the code so no one's
# real name or address lives in the repo.
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_FIRST_NAME="Admin"
# SEED_ADMIN_LAST_NAME=""

# DEV-ONLY testing sign-in (lib/dev-auth.ts), localhost only, never in production.
# Remove before shipping. Set to 1 to show "Dev sign-in" on /sign-in.
# DEV_AUTH=1

# Receipt prices (Phase 24): Azure AI Document Intelligence custom-subdomain endpoint.
# Entra-only (the app's registration needs "Cognitive Services User" on the resource). README "Receipts".
# DOCINTEL_ENDPOINT="https://<name>.cognitiveservices.azure.com/"

# Background jobs (Phase 27: money syncs and alerts, lib/background.ts). On in production,
# off in development. 1 turns them on locally, 0 turns them off anywhere.
# BACKGROUND_JOBS=1
