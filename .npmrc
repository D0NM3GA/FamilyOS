# Supply-chain hardening (2026-10-08). See README "Dependencies".
#
# Worms like Shai-Hulud spread through install scripts in freshly published versions of
# popular packages, and are usually caught and pulled within days.

# Exact versions in package.json, never ^ or ~ ranges.
save-exact=true

# When npm picks a version (npm install <pkg>, a new or changed range), only ones published
# more than 7 days ago. It doesn't re-check versions already in package-lock.json (npm ci
# installs those as they are): run `npm run deps:check` on any lockfile change. A security
# fix that can't wait: add it to min-release-age-exclude for that one install, then remove it.
min-release-age=7

# Install scripts run only for packages approved in package.json "allowScripts" (pinned to a
# version); anything else with an install script fails the install instead of running.
strict-allow-scripts=true

# Refuse to install with an npm too old to understand the two settings above (package.json
# "engines"), which would otherwise ignore them and run every install script.
engine-strict=true

# Registry packages only: no git or tarball-URL dependencies, which would skip the registry's
# signatures and the cooldown.
allow-git=none
allow-remote=none

fund=false
