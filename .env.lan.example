# Settings for `npm run dev:lan` (Phase 10.5): the dev server over HTTPS on a real
# hostname, so phones on the LAN can use the camera scanner and sign in with Microsoft.
# Copy to .env.lan (gitignored). See README.md "Testing on phones".

# The hostname every device uses. Its DNS must point at this PC's LAN address.
DEV_LAN_HOST="dev.example.com"

# A publicly trusted certificate for that hostname (e.g. Let's Encrypt via a DNS challenge),
# as PEM files. *.pem is gitignored; keep them outside the repo anyway.
DEV_HTTPS_KEY="C:/certs/dev.example.com-key.pem"
DEV_HTTPS_CERT="C:/certs/dev.example.com-chain.pem"

# Optional; default 3000.
# DEV_LAN_PORT="3000"
