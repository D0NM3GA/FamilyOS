{
  "name": "familyos",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "postinstall": "prisma generate && node scripts/copy-zxing-wasm.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "postbuild": "node scripts/standalone-assets.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:seed": "prisma db seed",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:studio": "prisma studio",
    "db:backup": "node scripts/backup-db.mjs",
    "test": "vitest run",
    "test:db": "vitest run --mode db --no-file-parallelism .db.test",
    "test:e2e": "playwright test",
    "deps:check": "node scripts/check-deps.mjs",
    "privacy:check": "node scripts/check-privacy.mjs",
    "predev": "prisma generate && node scripts/copy-zxing-wasm.mjs",
    "prebuild": "node scripts/copy-zxing-wasm.mjs",
    "dev:lan": "npm run predev && node scripts/dev-lan.mjs"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/nextjs": "11.8.0",
    "argon2": "0.45.1",
    "barcode-detector": "3.2.2",
    "better-auth": "1.7.7",
    "ical.js": "2.2.1",
    "lucide-react": "1.24.0",
    "next": "16.4.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tw-animate-css": "1.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "20.19.43",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.2",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild": false,
    "unrs-resolver": false,
    "fsevents": false
  },
  "overrides": {
    "mysql2": "3.24.4",
    "deepmerge-ts": "8.0.2",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.19.0"
  }
}
