# Phase 43: the production settings file (README "Running in production"). Copy it to
# /etc/familyos/familyos.env on the server (or FAMILYOS_ENV_FILE), fill it in, then
#   chmod 600 /etc/familyos/familyos.env
# Never commit the filled-in copy, and keep a copy in the password manager: a database backup
# is only usable with BETTER_AUTH_SECRET and INTEGRATION_ENCRYPTION_KEY.
# Compose reads this file and expands "$" in it: write a literal $ in a value as $$.

# The app's permanent address, the Cloudflare hostname. Passkeys are bound to it: changing it
# later strands every passkey, so choose it before the first one is made.
BETTER_AUTH_URL="https://familyos.example.com"

# Phase 61c: two database logins. MIGRATE_DATABASE_URL is the owner (the db service's user), with
# the same password as /etc/familyos/secrets/db_password: migrations run as it. DATABASE_URL is the
# app's own login, which the migrate service makes on every start with the password written here
# and data rights only (SELECT, INSERT, UPDATE, DELETE). Pick a different password for each
# (openssl rand -hex 24). Letters and digits only, or percent-encode @ : / % # in these URLs.
MIGRATE_DATABASE_URL="postgresql://familyos:CHANGE_ME@db:5432/familyos?schema=public"
DATABASE_URL="postgresql://familyos_app:CHANGE_ME_TOO@db:5432/familyos?schema=public"

# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))", once each.
BETTER_AUTH_SECRET=""
INTEGRATION_ENCRYPTION_KEY=""
# Phase 67c: only while changing INTEGRATION_ENCRYPTION_KEY (README "Changing the encryption key"):
# the old key, so what it sealed still opens until the app has re-sealed it all.
# INTEGRATION_ENCRYPTION_KEY_PREVIOUS=""

# The tunnel's fixed address in docker-compose.prod.yml.
TRUSTED_PROXIES="172.30.43.10"

# Optional: the time zone until the household has one. Phase 49: the app then keeps the
# household's own (Settings → Household), whatever this says.
TZ="America/New_York"

# Push services, the weather service and Let's Encrypt (the break-glass certificate) ask who runs
# this server.
CONTACT_EMAIL=""

# Phase 42: only requests through Cloudflare Access reach the app. From the Access application:
# the team domain (<team>.cloudflareaccess.com) and its Application Audience (AUD) tag.
# Left empty, the app refuses every request (it says why in its log), so a lost value can't put
# it on the internet unguarded. To run without Access on purpose, set CF_ACCESS_DISABLED=1.
CF_ACCESS_TEAM_DOMAIN=""
CF_ACCESS_AUD=""
CF_ACCESS_DISABLED=""

# Phase 42.7: the VM's home-network address, where the break-glass entrance listens when it's on.
BREAK_GLASS_LAN_IP=""

# Optional, as in .env.example: Microsoft 365 (all three or none), an OIDC provider (all four or
# none), the alert mailbox, the Outlook calendar default, receipts.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID=""
OIDC_DISCOVERY_URL=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_NAME=""
ALERT_MAILBOX=""
FAMILY_CALENDAR_NAME=""
# DOCINTEL_ENDPOINT=""

# Optional: the scopes your OIDC provider is asked for (default "openid email profile").
OIDC_SCOPES=""

# Optional: Sentry error monitoring (README "Error monitoring"). Read when the app starts, never
# built into the image; changing it needs only a restart.
SENTRY_DSN=""

# Optional, Phase 61: a check-in URL (healthchecks.io's convention) called after each run of the
# background jobs, with /fail on the end when one failed. http or https.
HEALTHCHECK_PING_URL=""

# Phone-alert keys: leave unset; the server makes and keeps its own (Phase 45.2). Don't paste a
# development machine's keys here.

# Background jobs (money syncs, alerts) are on by default in production; BACKGROUND_JOBS=0 turns
# them off.

# Never set DEV_AUTH here: the app refuses to start with it in production.
